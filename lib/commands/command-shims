#!/usr/bin/env bash

set -euo pipefail

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

tool_dir="${ASDF_DOTNET_GLOBAL_TOOL_PATH:-${HOME:?HOME is not set}/.dotnet/tools}"
shim_dir="${ASDF_DOTNET_SHIM_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/asdf-dotnet/bin}"
marker="# Generated by asdf-dotnet. Do not edit."

if [ "$tool_dir" = "$shim_dir" ]; then
  fail "The global tool directory and shim directory must be different."
fi

if [ ! -d "$tool_dir" ]; then
  fail "Global tool directory not found: $tool_dir. Install a global tool first."
fi

asdf_bin=$(asdf_binary)
mkdir -p "$shim_dir"

tmp_shim=
trap 'if [ -n "${tmp_shim:-}" ]; then rm -f "$tmp_shim"; fi' EXIT

created=0
removed=0
skipped=0

for tool in "$tool_dir"/*; do
  [ -f "$tool" ] || continue
  [ -x "$tool" ] || continue

  name=${tool##*/}
  [ "$name" = "dotnet" ] && continue

  target="$shim_dir/$name"

  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ -L "$target" ] || ! grep -qF "$marker" "$target" 2>/dev/null; then
      printf 'asdf-dotnet: skipping %s: not generated by asdf-dotnet.\n' "$target" >&2
      skipped=$((skipped + 1))
      continue
    fi
  fi

  tmp_shim=$(mktemp "$shim_dir/.asdf-dotnet.XXXXXX")

  {
    printf '%s\n' '#!/usr/bin/env bash'
    printf '%s\n' 'set -euo pipefail'
    printf '%s\n' "$marker"
    printf 'tool_name=%q\n' "$name"
    printf 'tool_dir=%q\n' "$tool_dir"
    printf 'asdf_bin=%q\n' "$asdf_bin"
    cat <<'EOF'
if [ -n "${ASDF_DOTNET_GLOBAL_TOOL_PATH:-}" ]; then
  tool_dir=$ASDF_DOTNET_GLOBAL_TOOL_PATH
fi

if [ -n "${ASDF_BIN:-}" ]; then
  asdf_bin=$ASDF_BIN
fi

real_tool="$tool_dir/$tool_name"
if [ ! -x "$real_tool" ]; then
  echo "asdf-dotnet: global tool not found: $real_tool" >&2
  exit 127
fi

exec "$asdf_bin" cmd dotnet exec -- "$real_tool" "$@"
EOF
  } >"$tmp_shim"

  if [ -f "$target" ] && [ -x "$target" ] && cmp -s "$tmp_shim" "$target"; then
    rm -f "$tmp_shim"
    continue
  fi

  chmod +x "$tmp_shim"
  mv -f "$tmp_shim" "$target"
  created=$((created + 1))
done

for target in "$shim_dir"/*; do
  [ -f "$target" ] || continue
  grep -qF "$marker" "$target" 2>/dev/null || continue

  name=${target##*/}
  if [ ! -f "$tool_dir/$name" ] || [ ! -x "$tool_dir/$name" ]; then
    rm -f "$target"
    removed=$((removed + 1))
  fi
done

printf 'Global tool directory: %s\n' "$tool_dir"
printf 'Shim directory: %s\n' "$shim_dir"
printf 'Created %d, removed %d, skipped %d.\n' "$created" "$removed" "$skipped"

if [ "$skipped" -gt 0 ]; then
  printf 'Skipped files were not generated by asdf-dotnet and were left unchanged.\n'
fi

printf 'Add this to your shell profile before the global tool directory:\n\n'
printf '  export PATH=%q%s\n' "$shim_dir" ":\$PATH"
