#!/usr/bin/env bash

set -euo pipefail

plugin_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

# shellcheck source=lib/utils.bash
source "${plugin_dir}/lib/utils.bash"

versions=$(list_stable_versions)

if [ -n "${1:-}" ]; then
  versions=$(printf '%s\n' "$versions" | grep -E "^$1" || true)
fi

version=$(printf '%s\n' "$versions" | tail -n 1)

if [ -n "$version" ]; then
  printf '%s\n' "$version"
fi
