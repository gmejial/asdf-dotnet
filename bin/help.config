#!/usr/bin/env bash

set -euo pipefail

cat <<'EOF'
To let asdf read the SDK version from global.json, add this to ~/.asdfrc:

  legacy_version_file = yes

.tool-versions still takes precedence. The plugin reads the sdk.version
value from global.json; global.json's rollForward setting is not used to
choose a different asdf install.
EOF
